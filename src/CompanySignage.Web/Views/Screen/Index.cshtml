@model List<CompanySignage.Application.DTOs.Screen.ScreenDto>
@{
    ViewData["Title"] = "Ekranlar";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Ekranlar</h2>
    <div class="d-flex gap-2">
        <a href="/Screen/DownloadInstaller" class="btn btn-success">Ekran Kurulum Paketini İndir</a>
        <a href="/Screen/Create" class="btn btn-primary">+ Yeni Ekran</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card p-3">
    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle">
            <thead>
                <tr>
                    <th>Durum</th>
                    <th>Ad</th>
                    <th>Kod</th>
                    <th>Çözünürlük</th>
                    <th>IP</th>
                    <th>Son Bağlantı</th>
                    <th>Yayın</th>
                    <th style="min-width:240px">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var screen in Model)
                {
                    <tr>
                        <td><span class="badge bg-@screen.StatusColor">@screen.StatusText</span></td>
                        <td>@screen.Name</td>
                        <td><code>@screen.ScreenCode</code></td>
                        <td>
                            <span class="small">
                                @screen.ScreenWidth&times;@screen.ScreenHeight<br />
                                <span class="text-secondary">@screen.Orientation</span>
                            </span>
                        </td>
                        <td>@(screen.IpAddress ?? "-")</td>
                        <td>
                            @if (screen.LastSeenAt.HasValue)
                            {
                                @screen.LastSeenAt.Value.ToLocalTime().ToString("dd.MM HH:mm")
                            }
                            else
                            {
                                <span class="text-secondary">-</span>
                            }
                        </td>
                        <td>@(screen.CurrentPlaylistName ?? screen.CurrentMediaName ?? "-")</td>
                        <td>
                            <div class="d-flex flex-wrap gap-1">
                                <a href="/Playlist" class="btn btn-sm btn-success">Liste Yayınla</a>
                                <a href="/Screen/Edit/@screen.Id" class="btn btn-sm btn-outline-light">Düzenle</a>
                                <form method="post" action="/Screen/Refresh/@screen.Id" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-info">Yenile</button>
                                </form>
                                <form method="post" action="/Screen/Stop/@screen.Id" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-warning">Durdur</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
