@model CompanySignage.Application.DTOs.Screen.CreateScreenDto
@{
    ViewData["Title"] = "Yeni Ekran";
}

<div class="mb-4">
    <h2 class="mb-1">Yeni Ekran Ekle</h2>
    <div class="text-secondary">Ekranın adını, yönünü ve çözünürlüğünü seçin.</div>
</div>

@if (ViewData["Error"] != null)
{
    <div class="alert alert-danger">@ViewData["Error"]</div>
}

<div class="card p-4" style="max-width: 720px">
    <form method="post" id="screenForm">
        @Html.AntiForgeryToken()

        <div class="mb-4">
            <label class="form-label fs-5">1. Ekranın adı</label>
            <input type="text" name="Name" class="form-control form-control-lg" value="@Model?.Name" required placeholder="Örnek: Lobi Ekranı" />
        </div>

        <div class="mb-4">
            <label class="form-label fs-5">2. Ekran kodu</label>
            <input type="text" name="ScreenCode" class="form-control form-control-lg" value="@Model?.ScreenCode" required placeholder="Örnek: LOBI-01" />
            <div class="form-text">Kurulum sırasında bu kod kullanılacak. Boşluk kullanmayın.</div>
        </div>

        <div class="mb-4">
            <label class="form-label fs-5 d-block">3. Ekran yönü</label>
            <div class="row g-2">
                <div class="col-6">
                    <input type="radio" class="btn-check" name="Orientation" id="landscape" value="Landscape" checked onchange="buildResolutionOptions()" />
                    <label class="btn btn-outline-primary w-100 py-3" for="landscape">
                        <strong>Yatay</strong><br /><span class="small">Televizyon / monitör</span>
                    </label>
                </div>
                <div class="col-6">
                    <input type="radio" class="btn-check" name="Orientation" id="portrait" value="Portrait" onchange="buildResolutionOptions()" />
                    <label class="btn btn-outline-primary w-100 py-3" for="portrait">
                        <strong>Dikey</strong><br /><span class="small">Totem / dik ekran</span>
                    </label>
                </div>
            </div>
        </div>

        <div class="mb-4">
            <label class="form-label fs-5" for="resolutionSelect">4. Başlangıç çözünürlüğü</label>
            <select class="form-select form-select-lg" id="resolutionSelect" onchange="applyResolution()"></select>
            <input type="hidden" name="ScreenWidth" id="screenWidth" value="1920" />
            <input type="hidden" name="ScreenHeight" id="screenHeight" value="1080" />
            <div class="form-text">Player ilk bağlandığında gerçek monitör çözünürlüğünü otomatik algılar ve bu değeri günceller.</div>
        </div>

        <div class="mb-4">
            <label class="form-label fs-5 d-block">5. Görüntü ekrana nasıl yerleşsin?</label>
            <div class="row g-2">
                <div class="col-12">
                    <input type="radio" class="btn-check" name="DisplayMode" id="displayFill" value="Fill" checked />
                    <label class="btn btn-outline-success w-100 h-100 py-3" for="displayFill">
                        <strong>Tam Ekran (Kırpmasız)</strong><br />
                        <span class="small">Görüntünün tamamını ekran oranına göre esnetir; kırpma ve boşluk olmaz.</span>
                    </label>
                </div>
            </div>
        </div>

        <details class="mb-4">
            <summary class="text-secondary">İsteğe bağlı açıklama</summary>
            <textarea name="Description" class="form-control mt-2" rows="2" placeholder="Ekranın konumu vb.">@Model?.Description</textarea>
        </details>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary btn-lg">Ekranı Kaydet</button>
            <a href="/Screen" class="btn btn-outline-secondary btn-lg">Vazgeç</a>
        </div>
    </form>
</div>

@section Scripts {
<script>
    const landscapeResolutions = [
        [1260, 720], [1280, 720], [1360, 768], [1366, 768],
        [1600, 900], [1920, 1080], [2560, 1440], [3840, 2160]
    ];

    function buildResolutionOptions() {
        const portrait = document.getElementById('portrait').checked;
        const select = document.getElementById('resolutionSelect');
        const resolutions = landscapeResolutions.map(function (size) {
            return portrait ? [size[1], size[0]] : size;
        });

        select.innerHTML = '';
        resolutions.forEach(function (size) {
            const option = document.createElement('option');
            option.value = size[0] + 'x' + size[1];
            option.textContent = size[0] + ' × ' + size[1];
            if ((!portrait && size[0] === 1920 && size[1] === 1080) ||
                (portrait && size[0] === 1080 && size[1] === 1920)) {
                option.selected = true;
            }
            select.appendChild(option);
        });
        applyResolution();
    }

    function applyResolution() {
        const parts = document.getElementById('resolutionSelect').value.split('x');
        document.getElementById('screenWidth').value = parts[0];
        document.getElementById('screenHeight').value = parts[1];
    }

    buildResolutionOptions();
</script>
}
