@model List<CompanySignage.Application.DTOs.Media.MediaFileDto>
@{
    ViewData["Title"] = "İçerikler";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">İçerikler</h2>
        <div class="text-secondary">Görsel ve videoları yükleyip saklayın; yayınlama oynatma listelerinden yapılır.</div>
    </div>
    <a href="/Media/Upload" class="btn btn-primary">+ İçerik Yükle</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card p-3">
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <h5>Henüz içerik yok</h5>
            <p class="text-secondary">İlk görselinizi veya videonuzu yükleyin.</p>
            <a href="/Media/Upload" class="btn btn-primary">İçerik Yükle</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle">
                <thead>
                    <tr>
                        <th>Önizleme</th>
                        <th>Ad</th>
                        <th>Tür</th>
                        <th>Boyut</th>
                        <th>Süre</th>
                        <th>Ses</th>
                        <th>Durum</th>
                        <th>Tarih</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var media in Model)
                    {
                        <tr>
                            <td>
                                @if (media.MediaType == CompanySignage.Domain.Enums.MediaType.Image)
                                {
                                    <img src="@media.FileUrl" class="media-thumb" alt="@media.Name" />
                                }
                                else
                                {
                                    <span class="badge bg-primary p-2">Video</span>
                                }
                            </td>
                            <td>@media.Name</td>
                            <td>@media.MediaTypeText</td>
                            <td>@media.FileSizeText</td>
                            <td>@(media.MediaType == CompanySignage.Domain.Enums.MediaType.Image ? media.DisplayDuration + " sn" : "Video sonu")</td>
                            <td>@(media.SoundEnabled ? "Açık" : "Kapalı")</td>
                            <td>
                                <span class="badge bg-@(media.IsActive ? "success" : "secondary")">
                                    @(media.IsActive ? "Aktif" : "Pasif")
                                </span>
                            </td>
                            <td>@media.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a href="@media.FileUrl" target="_blank" class="btn btn-sm btn-outline-info">Görüntüle</a>
                                    <a href="/Media/Edit/@media.Id" class="btn btn-sm btn-outline-light">Düzenle</a>
                                    <form method="post" action="/Media/Delete/@media.Id" class="d-inline" onsubmit="return confirm('Bu içeriği silmek istediğinize emin misiniz?')">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-sm btn-outline-danger">Sil</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
