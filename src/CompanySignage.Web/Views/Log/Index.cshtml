@model List<CompanySignage.Domain.Entities.ActivityLog>
@{
    ViewData["Title"] = "Sistem Logları";
}

<h2 class="mb-4">Sistem Logları</h2>

<div class="card p-3">
    <div class="table-responsive">
        <table class="table table-dark table-hover table-sm align-middle">
            <thead>
                <tr>
                    <th>Tarih</th>
                    <th>Kullanıcı</th>
                    <th>İşlem</th>
                    <th>Açıklama</th>
                    <th>IP</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model)
                {
                    <tr>
                        <td class="text-nowrap">@log.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</td>
                        <td>@(log.User?.Username ?? "Sistem")</td>
                        <td><code>@log.Action</code></td>
                        <td>@log.Description</td>
                        <td>@(log.IpAddress ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
