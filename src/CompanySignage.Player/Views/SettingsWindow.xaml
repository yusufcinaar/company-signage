<Window x:Class="CompanySignage.Player.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Company Signage Player - Ayarlar"
        Width="480" Height="480"
        WindowStartupLocation="CenterScreen"
        Background="#12151C"
        ResizeMode="NoResize">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="📺 Player Ayarları" FontSize="22" FontWeight="Bold"
                   Foreground="White" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Sunucu Adresi (örn: http://192.0.2.50:5000)" Foreground="#9CA3AF" Margin="0,0,0,4"/>
            <TextBox x:Name="ServerUrlBox" Padding="8" FontSize="14"
                     Background="#1C212C" Foreground="White" BorderBrush="#2A3040"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="Ekran Kodu (örn: SCREEN-001)" Foreground="#9CA3AF" Margin="0,0,0,4"/>
            <TextBox x:Name="ScreenCodeBox" Padding="8" FontSize="14"
                     Background="#1C212C" Foreground="White" BorderBrush="#2A3040"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock Text="Cihaz Tokenı" Foreground="#9CA3AF" Margin="0,0,0,4"/>
            <TextBox x:Name="DeviceTokenBox" Padding="8" FontSize="14"
                     Background="#1C212C" Foreground="White" BorderBrush="#2A3040"/>
        </StackPanel>

        <CheckBox Grid.Row="4" x:Name="SoundEnabledBox" Content="Video sesi açık"
                  Foreground="White" Margin="0,4,0,8"/>

        <CheckBox Grid.Row="5" x:Name="AutoStartBox" Content="Windows başlangıcında otomatik başlat"
                  Foreground="White" IsChecked="True" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="6" x:Name="ErrorText" Foreground="#EF4444" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Kaydet ve Başlat" Click="SaveButton_Click"
                    Padding="16,10" FontSize="14" FontWeight="Bold"
                    Background="#4F8EF7" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
