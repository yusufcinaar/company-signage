<Window x:Class="CompanySignage.Player.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Company Signage Player"
        WindowStyle="None"
        WindowState="Maximized"
        Background="Black"
        Cursor="None"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid>
        <!-- Medya oynatma alanı -->
        <Grid x:Name="PlaybackGrid" Background="Black" UseLayoutRounding="True" SnapsToDevicePixels="True"/>

        <!-- Bağlantı durumu göstergesi (sağ üst köşe, yarı saydam) -->
        <Border x:Name="StatusBar"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,10,10,0" Padding="8,4"
                Background="#80000000" CornerRadius="4"
                Opacity="0.5">
            <TextBlock x:Name="StatusText" Foreground="White" FontSize="11">
                ● Bağlanıyor...
            </TextBlock>
        </Border>

        <!-- Hata göstergesi (alt köşe) -->
        <Border x:Name="ErrorBar"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="10,0,0,10" Padding="8,4"
                Background="#80EF4444" CornerRadius="4"
                Visibility="Collapsed">
            <TextBlock x:Name="ErrorText" Foreground="White" FontSize="11"/>
        </Border>
    </Grid>
</Window>
